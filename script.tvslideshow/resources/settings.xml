<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<settings version="1">
    <section id="script.tvslideshow">
        <category id="general" label="30000">
            <group id="general">
                <setting id="secondsPerPhoto" type="integer" label="30001" help="30002">
                    <level>0</level>
                    <default>8</default>
                    <constraints>
                        <minimum>1</minimum>
                        <step>1</step>
                        <maximum>120</maximum>
                    </constraints>
                    <control format="integer" type="slider">
                        <popup>false</popup>
                    </control>
                </setting>
                <setting id="randomize" type="boolean" label="30003" help="30004">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle"/>
                </setting>
                <setting id="backgroundColor" type="string" label="30005" help="30006">
                    <level>0</level>
                    <default>ff000000</default>
                    <control type="colorbutton"/>
                </setting>
                <setting id="photoFit" type="integer" label="30007" help="30008">
                    <level>0</level>
                    <default>2</default>
                    <constraints>
                        <options>
                            <option label="30009">2</option>
                            <option label="30010">1</option>
                        </options>
                    </constraints>
                    <control format="integer" type="spinner"/>
                </setting>
                <setting id="photosDir" type="path" label="30011" help="30012">
                    <level>0</level>
                    <default>/storage/Slideshow/photos</default>
                    <constraints>
                        <allowempty>false</allowempty>
                        <writable>false</writable>
                        <sources>
                            <source>files</source>
                        </sources>
                    </constraints>
                    <control type="button" format="path">
                        <heading>30011</heading>
                    </control>
                </setting>
            </group>
        </category>
    </section>
</settings>
